# Shared dev settings, loaded by every `dev:*` task in deno.json.
# This file is committed, so never put secrets here: use .env.local (git-ignored) instead.

# Axum server (Web and API)
AXUM_LISTEN_HOST=127.0.0.1  # Interface to listen to
AXUM_LISTEN_PORT=3000       # Port to listen to
AXUM_LISTEN_BIND=${AXUM_LISTEN_HOST}:${AXUM_LISTEN_PORT}
AXUM_TARGET_URL=http://${AXUM_LISTEN_BIND}  # Where clients send their requests


# Vite dev servers: one for the browser, one for the Tauri WebView
VITE_BROWSER_PORT=5173
VITE_TAURI_PORT=1420


# Tauri dev config
TAURI_DEV_URL=http://localhost:${VITE_TAURI_PORT}
TAURI_DEV_CONFIG={"build":{"devUrl":"${TAURI_DEV_URL}"}}
