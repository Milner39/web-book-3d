{
  "tasks": {
    "dev:axum": "cargo run -p web-book-3d-server",
    "dev:svelte": "deno task --cwd src-svelte dev",
    "dev:tauri": "deno task --cwd src-svelte tauri dev",
    "build:axum": "cargo build -p web-book-3d-server --profile server",
    "build:svelte": "deno task --cwd src-svelte build",
    "build:tauri": "deno task --cwd src-svelte tauri build",
    "check:svelte": "deno task --cwd src-svelte check",
    "tauri": "deno task --cwd src-svelte tauri"
  }
}
